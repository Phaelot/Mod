    <control type="container">
      <name>PlayerTradeButtons</name>
      <width>230px</width>
      <height>50px</height>
      <anchor>BottomMiddle</anchor>
      <offsety>55px</offsety>
    
      <control type="button">
        <name>ClearButton</name>
        <width>100px</width>
        <height>30px</height>
        <imgnormal>Data\Images\HUD\MainHUDNew\basicbutton_normal.png</imgnormal>
        <imghigh>Data\Images\HUD\MainHUDNew\basicbutton_mouseover.png</imghigh>
        <imgpress>Data\Images\HUD\MainHUDNew\basicbutton_pressed.png</imgpress>
        <onclick>ClearButtonClick</onclick>
        <tooltip>TT_CLEARTRADE</tooltip>
        <anchor>Middle</anchor>
        <offsetx>-55px</offsetx>
      
        <control type="text">
          <fontname>Trebuchet MS</fontname>
          <fontcolour>0,0,0</fontcolour>
          <fontsize>14px</fontsize>
          <width>100px</width>
          <height>30px</height>
          <bold>true</bold>
          <text>CLEARTRADE</text>
          <textanchor>Middle</textanchor>
        </control>  
      </control>
      
      <control type="button">
        <name>OfferButton</name>
        <width>100px</width>
        <height>30px</height>
        <imgnormal>Data\Images\HUD\MainHUDNew\basicbutton_normal.png</imgnormal>
