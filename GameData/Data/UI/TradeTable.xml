        <fontname>Trebuchet MS</fontname>
        <fontsize>13px</fontsize>
        <fontcolour>255,238,161</fontcolour>
        <textanchor>Middle</textanchor>
        <bold>true</bold>
      </control>

      <control type="text">
        <name>AcceptanceStatusText</name>
        <width>444px</width>
        <height>28px</height>
