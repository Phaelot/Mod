<?xml version="1.0" encoding="utf-8"?>
<form name="MainForm">
  <fullscreen>true</fullscreen>
  <scriptfile>SovereigntyTK.UI.TradeTable</scriptfile>
  <onload>FormLoaded</onload>
  <visible>false</visible>
  <name>TradeTable</name>

  <control type="image">
    <name>BG</name>
    <fullscreen>true</fullscreen>
    <forcemouse>true</forcemouse>
    <imagefile>Data\Images\Hud\bg.png</imagefile>
    <ignoremousemove>true</ignoremousemove>
  </control>

  <control type="image">
    <name>PanelBG</name>
    <width>960px</width>
    <height>600px</height>
    <anchor>Middle</anchor>
    
    <control type="image">
      <name>BG_Frame</name>
      <height>625px</height>
      <width>988px</width>
      <anchor>Middle</anchor>
      <imagefile>Data\Images\HUD\Purchase\unitwindow.png</imagefile>
    </control>
      
    <control type="text">
      <name>TradeTitleText</name>
      <width>960px</width>
      <height>30px</height>
      <offsety>10px</offsety>
      <fontname>Trebuchet MS</fontname>
      <fontsize>24px</fontsize>
      <fontcolour>255,238,161</fontcolour>
      <textanchor>Middle</textanchor>
      <bold>true</bold>
    </control>
      
    <control type="image">
      <name>OurItemsBG</name>
      <imagefile>Data\Images\Hud\bg.png</imagefile>
      <width>230px</width>
      <height>500px</height>
