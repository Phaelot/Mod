      <offsetx>-360px</offsetx>
      <offsety>20px</offsety>
    
      <control type="text">
        <name>OurItemsTitle</name>
        <width>230px</width>
        <height>20px</height>
        <fontname>Trebuchet MS</fontname>
        <fontsize>14px</fontsize>
        <fontcolour>255,238,161</fontcolour>
        <textanchor>Middle</textanchor>
        <bold>true</bold>
      </control>
    </control>
  
    <control type="image">
      <name>OurOffersBG</name>
